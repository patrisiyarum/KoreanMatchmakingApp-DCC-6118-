# Google Gemini API key (required for Chat Assistant)
# Get your key at: https://aistudio.google.com/apikey
# Never commit real keys. If Google returns "API key was reported as leaked", revoke the old key
# in Google AI Studio, create a new one, and update this value on the server only.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: model id (default: gemini-2.5-flash-lite). Free tier has strict per-model daily limits;
# switching models or enabling billing can help. See https://ai.google.dev/gemini-api/docs/rate-limits
# GEMINI_MODEL=gemini-2.0-flash

# Optional: MySQL table name for meetings if your DB used a different name/casing than migration `MeetingModel`.
# MEETING_TABLE_NAME=meetingmodel

# Optional: Backend port (default: 8080)
# PORT=8080
